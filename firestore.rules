rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 총무(관리자) 인증 헬퍼 함수 (Firebase Auth Custom Claims 'admin: true' 확인)
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // =========================================================================
    // 1. 일반 가족 공개 데이터 (Public)
    // - 비로그인 가족 누구나 읽기(read) 가능
    // - 생성/수정/삭제(write)는 오직 총무 관리자만 가능
    // =========================================================================

    // 전체 회비 잔액 및 월별 통계 요약 (개인정보 없음)
    match /public_summary/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 익명화된 공개 회계 장부 내역
    match /public_ledger/{txId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 가족 모임 및 여행 일정
    match /public_events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 가족 공지사항
    match /public_notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 2. 총무 전용 비공개 데이터 (Admin Only)
    // - 외부인 및 비로그인 가족 접근 절대 차단
    // - 읽기(read) 및 쓰기(write) 모두 총무(admin: true) 계정만 가능
    // =========================================================================

    // 회원 명부 (이름, 가족관계, 연락처)
    match /admin_members/{memberId} {
      allow read, write: if isAdmin();
    }

    // 개인별 월별 회비 납부 및 미납 기록
    match /admin_fee_records/{recordId} {
      allow read, write: if isAdmin();
    }

    // 원본 회계 거래 장부 및 상세 영수증 메모
    match /admin_transactions/{txId} {
      allow read, write: if isAdmin();
    }

    // 회계 이관, 시작 잔액, 실제 통장 잔액 및 회칙 설정
    match /admin_settings/{settingId} {
      allow read, write: if isAdmin();
    }

    // 총무 감사 로그 (수정/삭제 불가, 관리자 쓰기/읽기만 허용)
    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // 감사 로그 위변조 차단
    }

    // 권한 인계 이력
    match /admin_handovers/{handoverId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // 그 외 명시되지 않은 모든 경로는 기본 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
